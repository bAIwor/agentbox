PORT=8080

# Di-inject GMI otomatis saat sandbox berjalan. Untuk development lokal,
# isi dengan API key GMI Cloud kamu (JANGAN pernah di-commit).
GMI_MAAS_API_KEY=your_gmi_api_key_here

# Model ID default. WAJIB memakai ID yang ada di katalog GMI.
DEFAULT_MODEL=deepseek-ai/DeepSeek-V3.2

# Endpoint MaaS (OpenAI-compatible)
GMI_BASE_URL=https://api.gmi-serving.com/v1

# BSC RPC, dipisah koma, dipakai berurutan sampai ada yang berhasil.
BSC_RPC_URLS=https://bsc-rpc.publicnode.com,https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.defibit.io,https://1rpc.io/bnb

# Opsional: kalau diisi, endpoint /api/chat butuh header X-Agent-Token.
AGENT_ACCESS_TOKEN=
